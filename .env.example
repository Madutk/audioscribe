# audioscribe — Umgebungsvariablen. Kopiere diese Datei nach ".env" und fuelle sie aus.
# Die .env wird automatisch geladen (siehe src/audioscribe/config.py) und ist gitignored.

# --- HuggingFace-Token (PFLICHT fuer die Diarisierung / pyannote 3.1) ---
# Die Diarisierung (Sprecher-Trennung) ist das Kern-Feature und standardmaessig AN.
# 1. Account auf https://huggingface.co
# 2. Modell-Bedingungen akzeptieren (einmalig):
#    https://huggingface.co/pyannote/speaker-diarization-3.1
#    https://huggingface.co/pyannote/segmentation-3.0
# 3. Access-Token (read) erstellen: https://huggingface.co/settings/tokens
# Ohne Token laeuft nur "audioscribe run <datei> --no-diarize" (Transkript ohne Sprecher).
HF_TOKEN=

# --- Optionale Overrides (Defaults siehe config.py) ---
# AUDIOSCRIBE_WHISPER_MODEL=large-v3
# AUDIOSCRIBE_WHISPER_COMPUTE_TYPE=auto        # auto: cuda->float16, cpu->int8; bei VRAM-Knappheit: int8_float16 oder int8
# AUDIOSCRIBE_WHISPER_LANGUAGE=de              # oder "auto" fuer Spracherkennung
# AUDIOSCRIBE_BATCH_SIZE=8                      # bei OOM auf 4 senken
# AUDIOSCRIBE_DEVICE=auto                       # auto (Default: CUDA falls verfuegbar, sonst CPU) | cuda | cpu
# AUDIOSCRIBE_DIARIZATION=1                     # 0 = aus (entspricht --no-diarize)
# AUDIOSCRIBE_SENTENCES_PER_TIMESTAMP=2         # neuer Zeitstempel alle N Saetze (0 = ganzer Beitrag)

# --- Bildwechsel-Erkennung fuer Bildschirmaufnahmen (--frames) ---
# AUDIOSCRIBE_SCREENS=0                         # 1 = immer an (sonst je Lauf mit --frames)
# AUDIOSCRIBE_SCREEN_SENSITIVITY=mittel         # grob | mittel | fein
# AUDIOSCRIBE_SCREEN_FORMAT=jpg-1600            # jpg-1600 | jpg-1280 | png
# AUDIOSCRIBE_SCREEN_FPS=2                      # Abtastungen je Sekunde (1 = halbe Analysezeit)
# AUDIOSCRIBE_SCREEN_MIN_GAP=4                  # Mindestabstand zwischen zwei Standbildern (s)
# AUDIOSCRIBE_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# --- KI-Analyse per Claude-Agent ('audioscribe analyze', Extra 'agent') ---
# Anmeldung: einmal 'claude' starten und mit dem Claude-Abo einloggen - dann laeuft die
# Analyse ueber das Abo. ACHTUNG: ein gesetzter ANTHROPIC_API_KEY hat Vorrang und wird
# dann ueber die API (Console-Guthaben) abgerechnet.
# AUDIOSCRIBE_AGENT_MODEL=claude-opus-5         # oder Alias: opus | sonnet
# AUDIOSCRIBE_AGENT_SKILLS_DIR=~/.claude/skills # wird rekursiv nach SKILL.md durchsucht
# AUDIOSCRIBE_AGENT_SKILLS=transkript-normalisierung,prozessrekonstruktion,prozessdoku-qs,arbeitsanweisung-ableiten
# AUDIOSCRIBE_AGENT_MAX_TURNS=                  # leer = ohne Begrenzung
# AUDIOSCRIBE_AGENT_OUTPUT_DIR=./analysen       # Default-Ausgabeordner
# AUDIOSCRIBE_AGENT_PROZESSBILD=1               # 0 = kein prozessbild.png/.svg erzeugen
# AUDIOSCRIBE_AGENT_BPMN=1                      # 0 = kein BPMN-Modell (bpmn-modell.*) erzeugen
# AUDIOSCRIBE_BROWSER=                          # Edge/Chrome fuers Prozessbild (Default: automatisch)
