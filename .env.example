# audioscribe — Umgebungsvariablen. Kopiere diese Datei nach ".env" und fuelle sie aus.
# Die .env wird automatisch geladen (siehe src/audioscribe/config.py) und ist gitignored.

# --- HuggingFace-Token (PFLICHT fuer die Diarisierung / pyannote 3.1) ---
# Die Diarisierung (Sprecher-Trennung) ist das Kern-Feature und standardmaessig AN.
# 1. Account auf https://huggingface.co
# 2. Modell-Bedingungen akzeptieren (einmalig):
#    https://huggingface.co/pyannote/speaker-diarization-3.1
#    https://huggingface.co/pyannote/segmentation-3.0
# 3. Access-Token (read) erstellen: https://huggingface.co/settings/tokens
# Ohne Token laeuft nur "audioscribe run <datei> --no-diarize" (Transkript ohne Sprecher).
HF_TOKEN=

# --- Optionale Overrides (Defaults siehe config.py) ---
# AUDIOSCRIBE_WHISPER_MODEL=large-v3
# AUDIOSCRIBE_WHISPER_COMPUTE_TYPE=auto        # auto: cuda->float16, cpu->int8; bei VRAM-Knappheit: int8_float16 oder int8
# AUDIOSCRIBE_WHISPER_LANGUAGE=de              # oder "auto" fuer Spracherkennung; Vorgabe fuer die Einstellung "Sprache der Aufnahmen"
# AUDIOSCRIBE_BATCH_SIZE=8                      # bei OOM auf 4 senken
# AUDIOSCRIBE_DEVICE=auto                       # auto (Default: CUDA > MPS (Apple Silicon) > CPU) | cuda | mps | cpu
# AUDIOSCRIBE_ASR_BACKEND=auto                  # auto (Apple Silicon: mlx, sonst faster-whisper) | faster-whisper | mlx
# AUDIOSCRIBE_MLX_REPO=                         # Hugging-Face-Repo fuer MLX-Gewichte erzwingen (Default: mlx-community/whisper-*)
# PYTORCH_ENABLE_MPS_FALLBACK=1                 # macOS: fehlende MPS-Operatoren auf der CPU rechnen statt abzubrechen (start.sh setzt es)
# AUDIOSCRIBE_CPU_THREADS=0                     # Rechen-Threads fuer die Live-Transkription auf CPU: 0 = Bibliotheks-Default, sonst Zahl physischer Kerne
# --- Live-Schnitt und Vorschau (FR-55; kuerzer = weniger Verzoegerung, mehr Rechenlast) ---
# AUDIOSCRIBE_LIVE_PAUSE_S=0.6                  # Sprechpause, nach der ein Abschnitt geschlossen wird (0.45 auf schneller GPU/MLX)
# AUDIOSCRIBE_LIVE_PARTIAL_INTERVAL_S=2.0       # Vorschau hoechstens alle N Sekunden (1.0 auf GPU/MLX)
# AUDIOSCRIBE_LIVE_PARTIAL_MIN_S=1.0            # Vorschau fruehestens ab N Sekunden offenem Audio
# AUDIOSCRIBE_LIVE_VAD_EVERY_TICK=0             # 1 = Sprachaktivitaet jeden Takt (0,25 s) pruefen statt jeden zweiten
# AUDIOSCRIBE_DIARIZATION=1                     # 0 = aus (entspricht --no-diarize)
# AUDIOSCRIBE_SENTENCES_PER_TIMESTAMP=2         # neuer Zeitstempel alle N Saetze (0 = ganzer Beitrag)

# --- Bildwechsel-Erkennung fuer Bildschirmaufnahmen (--frames) ---
# AUDIOSCRIBE_SCREENS=0                         # 1 = immer an (sonst je Lauf mit --frames)
# AUDIOSCRIBE_SCREEN_SENSITIVITY=mittel         # grob | mittel | fein
# AUDIOSCRIBE_SCREEN_FORMAT=jpg-1600            # jpg-1600 | jpg-1280 | png
# AUDIOSCRIBE_SCREEN_FPS=2                      # Abtastungen je Sekunde (1 = halbe Analysezeit)
# AUDIOSCRIBE_SCREEN_MIN_GAP=4                  # Mindestabstand zwischen zwei Standbildern (s)
# AUDIOSCRIBE_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# --- KI-Analyse per Claude-Agent ('audioscribe analyze', Extra 'agent') ---
# Anmeldung: einmal 'claude' starten und mit dem Claude-Abo einloggen - dann laeuft die
# Analyse ueber das Abo. ACHTUNG: ein gesetzter ANTHROPIC_API_KEY hat Vorrang und wird
# dann ueber die API (Console-Guthaben) abgerechnet.
# AUDIOSCRIBE_AGENT_MODEL=claude-opus-5         # oder Alias: opus | sonnet; Vorgabe fuer die Einstellung "Modell fuer die KI-Analyse"
# AUDIOSCRIBE_AGENT_SKILLS_DIR=~/.claude/skills # wird rekursiv nach SKILL.md durchsucht
# AUDIOSCRIBE_AGENT_SKILLS=transkript-normalisierung,prozessrekonstruktion,prozessdoku-qs,arbeitsanweisung-ableiten
# AUDIOSCRIBE_AGENT_MAX_TURNS=                  # leer = ohne Begrenzung
# AUDIOSCRIBE_AGENT_OUTPUT_DIR=./analysen       # Default-Ausgabeordner ohne Projekt (im Projekt: <Sitzungsordner>/analysen)
# AUDIOSCRIBE_AGENT_PROZESSBILD=1               # 0 = kein prozessbild.png/.svg erzeugen
# AUDIOSCRIBE_AGENT_BPMN=1                      # 0 = kein BPMN-Modell (bpmn-modell.*) erzeugen
# AUDIOSCRIBE_BROWSER=                          # Edge/Chrome fuers Prozessbild (Default: automatisch; macOS: /Applications)

# --- Souffleur: Live-Abgleich mit dem LLM-Wiki (PRD §20, Projekte: PRD §21) ---
# In der Oberflaeche gehoert das Wiki zum Projekt (<wiki>/.audioscribe/projekt.json); KI-Dienst
# und Modell stehen in den Einstellungen (global, je Projekt ueberschreibbar). Die Werte hier
# sind die Vorgaben, solange dort nichts gespeichert ist.
# AUDIOSCRIBE_WIKI_DIR=                         # Wiki-Ordner OHNE Projekt (Kommandozeile, Tests); belegt ausserdem den Assistenten "Neues Projekt" vor
# AUDIOSCRIBE_SOUFFLEUR_BACKEND=claude-agent    # KI-Dienst: claude-agent (Agent SDK, Anmeldung von Claude Code) | attrappe (Tests)
# AUDIOSCRIBE_SOUFFLEUR_MODEL=claude-sonnet-5   # Modell fuer den Souffleur (in der Souffleur-Karte heisst es nur "KI")
# AUDIOSCRIBE_CONFIG_DIR=                       # Ordner der Einstellungsdatei (Default: %APPDATA%, ~/Library/Application Support, ~/.config)
